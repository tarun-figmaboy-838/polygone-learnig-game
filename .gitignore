node_modules/

# Playwright screenshots from the verification runs. Regenerated by
# `npm run test:browser`; nothing in the game reads them.
artifacts/

# A copy of the sprite sheets the game plays, grouped by what each state
# MEANS, for re-costuming the character. 5.6MB of duplicates of files that
# are already in assets/swiftee/, so it is generated rather than stored:
#   node tools/export-used-sprites.js
swiftee-in-use/

# The raw voice take: one 3MB mp3 of every line read end to end, dropped in
# for cutting up. The game plays per-line clips from assets/vo/ (see
# docs/VO.md), so this is source material, not a deliverable — it would ship
# 3MB to every child and play nothing.
src/audio/voices.mp3

