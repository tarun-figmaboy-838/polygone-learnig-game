.vercel/

# Cuts of an earlier take; nothing reads them. The take that voices the game
# is assets/source/gamevo.mp3, cut into assets/vo/<id>.mp3 by tools/split-vo.js.
assets/vo/take/

# a collaborator's local preview renders and listening samples, not part of the game
preview/
